  "definitions": {
    "LicenseAdminServiceGrantModuleBody": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/v1EntitlementKind"
        },
        "durationDays": {
          "type": "integer",
          "format": "int32"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
