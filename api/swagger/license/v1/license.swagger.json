      "properties": {
        "reason": {
          "type": "string"
        }
      }
    },
    "LicenseAdminServiceUnrevokeKeyBody": {
      "type": "object"
    },
    "LicenseAdminServiceUpdateKeyBody": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "slots": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1ActivateRequest": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "licenseKey": {
          "type": "string"
        },
        "fingerprintId": {
          "type": "string",
          "description": "Device fingerprint, \"^v1\\.\" + 64 lowercase hex chars."
        },
        "deviceToken": {
          "type": "string",
          "description": "Stable device identity anchor (never regenerated by the client)."
        },
        "evictDeviceToken": {
          "type": "string",
          "description": "Optional: only sent when retrying after a 409 slot_limit response."
        }
      },
      "description": "ActivateRequest drives the idempotent activation converger: first activate,\nheartbeat, fingerprint rebind, post-purchase refresh, or evict-and-retry.\nBoth `key` and `license_key` are accepted (client sends `key`; docs wrote\n`licenseKey`); the server takes the first non-empty one. Key shape is\nvalidated after normalization in the service (BAD_KEY_FORMAT), so the\ntransport only guards length."
    },
    "v1ActivateResponse": {
      "type": "object",
      "properties": {
        "payload": {
          "type": "string",
          "title": "canonical JSON string (cert v1, see docs/design.md §8)"
        },
        "signature": {
          "type": "string",
          "title": "base64 (standard alphabet, padded) of the 64-byte Ed25519 signature"
        },
        "slots": {
          "$ref": "#/definitions/v1SlotSummary"
        }
      },
      "description": "ActivateResponse carries the detached-signature cert. `payload` MUST be\nthe exact canonical JSON bytes that were signed — the client re-computes\ncanonical form and compares byte-for-byte."
    },
    "v1CreateKeyRequest": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "slots": {
          "type": "integer",
          "format": "int32",
          "description": "0 = default 3 slots."
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1EntitlementInput"
          }
        }
      }
    },
    "v1CreateKeyResponse": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/v1KeyInfo"
        },
        "plaintextKey": {
          "type": "string",
          "description": "Plaintext key, shown exactly once at creation (\"AV1D-XXXXX-XXXXX-XXXXX-XXXXX\")."
        }
      }
    },
    "v1DeactivateRequest": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "licenseKey": {
          "type": "string"
        },
        "deviceToken": {
          "type": "string"
        }
      },
      "description": "DeactivateRequest releases the caller's own slot (idempotent)."
    },
    "v1DeactivateResponse": {
      "type": "object",
      "properties": {
        "released": {
          "type": "boolean",
          "description": "false = the device was not in a slot (still a 200)."
        }
      }
    },
    "v1DeleteKeyResponse": {
      "type": "object"
    },
    "v1DeviceSlotInfo": {
      "type": "object",
      "properties": {
        "deviceToken": {
          "type": "string"
        },
        "fingerprintId": {
          "type": "string"
        },
        "firstSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string"
        }
      },
      "description": "DeviceSlotInfo describes one device occupying a slot. `name` is reserved\nfor a future device-name source; the server never sets it today."
    },
    "v1EntitlementInfo": {
      "type": "object",
      "properties": {
        "module": {
          "$ref": "#/definitions/v1Module"
        },
        "kind": {
          "$ref": "#/definitions/v1EntitlementKind"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "EntitlementInfo is the read-side view of one module entitlement.\nperpetual ⇒ expires_at unset; subscription/trial ⇒ expires_at always set."
    },
    "v1EntitlementInput": {
      "type": "object",
      "properties": {
        "module": {
          "$ref": "#/definitions/v1Module"
        },
        "kind": {
          "$ref": "#/definitions/v1EntitlementKind"
        },
        "durationDays": {
          "type": "integer",
          "format": "int32"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "EntitlementInput is one grant entry for CreateKey / GrantModule.\nFor subscription/trial: exactly one of duration_days (extend from\nmax(now, current expires_at)) or expires_at (absolute override).\nFor perpetual: neither may be set."
    },
    "v1EntitlementKind": {
      "type": "string",
      "enum": [
        "ENTITLEMENT_KIND_UNSPECIFIED",
        "ENTITLEMENT_KIND_PERPETUAL",
        "ENTITLEMENT_KIND_SUBSCRIPTION",
        "ENTITLEMENT_KIND_TRIAL"
      ],
      "default": "ENTITLEMENT_KIND_UNSPECIFIED",
      "description": "EntitlementKind is the billing model of an entitlement entry."
    },
    "v1GrantModuleResponse": {
      "type": "object",
      "properties": {
        "entitlement": {
          "$ref": "#/definitions/v1EntitlementInfo"
        }
      }
    },
    "v1HealthChecks": {
      "type": "object",
      "properties": {
        "db": {
          "type": "boolean"
        },
        "signing": {
          "type": "boolean"
        }
      }
    },
    "v1HealthResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "checks": {
          "$ref": "#/definitions/v1HealthChecks"
        }
      },
      "description": "HealthResponse is served at GET /healthz. Any failing check flips the RPC\nto Unavailable (HTTP 503 via the gateway)."
    },
    "v1KeyInfo": {
      "type": "object",
      "properties": {
        "licenseId": {
          "type": "string"
        },
        "keyPrefix": {
          "type": "string",
          "title": "first 8 chars of the normalized key, for support"
        },
        "label": {
          "type": "string"
        },
        "maxSlots": {
          "type": "integer",
          "format": "int32"
        },
        "usedSlots": {
          "type": "integer",
          "format": "int32"
        },
        "status": {
          "$ref": "#/definitions/v1KeyStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        },
        "entitlements": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1EntitlementInfo"
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DeviceSlotInfo"
          },
          "title": "populated by ShowKey only"
        }
      },
      "description": "KeyInfo never contains the plaintext key — only license_id/key_prefix."
    },
    "v1KeyStatus": {
      "type": "string",
      "enum": [
        "KEY_STATUS_UNSPECIFIED",
        "KEY_STATUS_ACTIVE",
        "KEY_STATUS_REVOKED"
      ],
      "default": "KEY_STATUS_UNSPECIFIED",
      "description": "KeyStatus is the lifecycle state of a license key. Revocation is a soft\nstate (rows kept); devices/entitlements survive and slots reattach on\nunrevoke."
    },
    "v1KickDeviceResponse": {
      "type": "object",
      "properties": {
        "kicked": {
          "type": "boolean",
          "description": "false = the device was not in a slot."
        }
      }
    },
    "v1ListKeyDevicesResponse": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DeviceSlotInfo"
          }
        }
      }
    },
    "v1ListKeysResponse": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1KeyInfo"
          }
        }
      }
    },
    "v1Module": {
      "type": "string",
      "enum": [
        "MODULE_UNSPECIFIED",
        "MODULE_DOWNLOADS",
        "MODULE_TOOLS"
      ],
      "default": "MODULE_UNSPECIFIED",
      "description": "Module is a sellable module. player/storage/sound/environment/settings are\nalways free and never enter the entitlement system. The client-facing\ntrial/start request carries the module as the lowercase wire name\n(\"downloads\"/\"tools\", matching the client contract) and converts at the\nservice boundary."
    },
    "v1Pong": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "title": "service name, e.g. \"license-service\""
        },
        "version": {
          "type": "string",
          "title": "semantic version (ldflags; \"dev\" by default)"
        },
        "gitCommit": {
          "type": "string",
          "title": "short commit hash (ldflags or VCS-embedded)"
        },
        "gitBranch": {
          "type": "string",
          "title": "git branch (ldflags)"
        },
        "buildTime": {
          "type": "string",
          "title": "build time, RFC3339 UTC (ldflags)"
        },
        "goVersion": {
          "type": "string",
          "title": "Go toolchain version (runtime, not injected)"
        },
        "status": {
          "type": "string",
          "title": "\"SERVING\" when serving normally"
        },
        "now": {
          "type": "string",
          "format": "int64",
          "title": "server time, Unix millis"
        },
        "startedAt": {
          "type": "string",
          "format": "int64",
          "title": "process start time, Unix millis"
        }
      },
      "description": "Pong is the health-check response — only public, non-sensitive info."
    },
    "v1ResetTrialResponse": {
      "type": "object",
      "properties": {
        "reset": {
          "type": "boolean",
          "description": "false = no trial row existed for (fingerprint_id, module)."
        }
      }
    },
    "v1RevokeKeyResponse": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/v1KeyInfo"
        }
      }
    },
    "v1RevokeModuleResponse": {
      "type": "object"
    },
    "v1ShowKeyResponse": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/v1KeyInfo"
        }
      }
    },
    "v1ShowPubKeyResponse": {
      "type": "object",
      "properties": {
        "publicKeyB64": {
          "type": "string",
          "description": "base64 of the 32-byte Ed25519 public key derived from the default seed."
        },
        "keyId": {
          "type": "string",
          "description": "Named (secondary) key, present only during a rotation transition."
        },
        "secondaryPublicKeyB64": {
          "type": "string"
        }
      }
    },
    "v1ShowTrialResponse": {
      "type": "object",
      "properties": {
        "trials": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TrialInfo"
          }
        }
      }
    },
    "v1SlotSummary": {
      "type": "object",
      "properties": {
        "used": {
          "type": "integer",
          "format": "int32"
        },
        "max": {
          "type": "integer",
          "format": "int32"
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1DeviceSlotInfo"
          }
        }
      },
      "description": "SlotSummary reports concurrent-slot usage after activate."
    },
    "v1TrialInfo": {
      "type": "object",
      "properties": {
        "fingerprintId": {
          "type": "string"
        },
        "module": {
          "$ref": "#/definitions/v1Module"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "firstDeviceToken": {
          "type": "string",
          "title": "audit only"
        }
      }
    },
    "v1TrialStartRequest": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "fingerprintId": {
          "type": "string"
        },
        "deviceToken": {
          "type": "string"
        },
        "licenseKey": {
          "type": "string"
        }
      },
      "description": "TrialStartRequest starts (or idempotently resumes) a keyless trial.\n`license_key` optionally merges the trial ledger into a keyed cert.\nmodule is the lowercase wire name from the client contract (\"downloads\" /\n\"tools\"); the service converts it to the Module enum at the boundary."
    },
    "v1TrialStartResponse": {
      "type": "object",
      "properties": {
        "payload": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "alreadyStarted": {
          "type": "boolean",
          "description": "true when a trial for (fingerprint_id, module) already existed — the\noriginal started_at is reused (reinstalling with a new device_token does\nNOT reset a trial)."
        }
      }
    },
    "v1UnrevokeKeyResponse": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/v1KeyInfo"
        }
      }
    },
    "v1UpdateKeyResponse": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/v1KeyInfo"
        }
      }
    }
  }
}
