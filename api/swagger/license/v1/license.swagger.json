            }
          }
        },
        "tags": [
          "LicenseService"
        ]
      }
    },
    "/v1/activate": {
      "post": {
        "summary": "Activate is the idempotent converger: first activation, 24h heartbeat,\nfingerprint rebind, entitlement refresh, and evict-retry all funnel here.",
        "operationId": "Activate",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ActivateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "ActivateRequest drives the idempotent activation converger: first activate,\nheartbeat, fingerprint rebind, post-purchase refresh, or evict-and-retry.\nBoth `key` and `license_key` are accepted (client sends `key`; docs wrote\n`licenseKey`); the server takes the first non-empty one. Key shape is\nvalidated after normalization in the service (BAD_KEY_FORMAT), so the\ntransport only guards length.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ActivateRequest"
            }
          }
        ],
        "tags": [
          "LicenseService"
        ]
      }
    },
