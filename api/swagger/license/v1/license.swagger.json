    "/v1/trial/start": {
      "post": {
        "summary": "TrialStart starts or resumes a keyless trial by (fingerprint_id, module).",
        "operationId": "TrialStart",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
