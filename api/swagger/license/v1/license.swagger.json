  "tags": [
    {
      "name": "LicenseService",
      "description": "LicenseService is the client-facing activation surface. The google.api.http\nannotations below are the routing contract for the future standalone HTTP\ngateway; this service itself runs gRPC-only."
    },
    {
      "name": "LicenseAdminService",
      "description": "LicenseAdminService is the operator surface (key issuance, entitlement and\ndevice management, trial resets, pubkey introspection). Every RPC requires\n`Authorization: Bearer \u003cADMIN_TOKEN\u003e`; the deployment layer additionally\nkeeps these paths off the public edge."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
