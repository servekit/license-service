# Environment template. Copy to .env and edit:
#   cp .env.example .env
#
# These values are docker-compose oriented (hostnames are compose service
# names). config.example.yaml references every value via ${VAR}, expanded by
# configx at startup. The binary never reads this file directly — load it into
# the environment:
#   - local binary (make run): godotenv loads .env automatically
#   - docker compose: reads .env for ${VAR} interpolation
#
# For LOCAL binary runs, change docker hostnames to local addresses, e.g.:
#   LICENSE_SERVICE_DATABASE_HOST: postgres -> localhost
#
# Never commit real production secrets — keep them in .env (gitignored), the CI
# secret store, or the deployment secret manager.

LICENSE_SERVICE_SERVER_GRPC_ADDR=:19096
# Empty = gRPC-only (HTTP face is served by a future standalone gateway;
# :18086 is reserved for it).
LICENSE_SERVICE_SERVER_HTTP_ADDR=

LICENSE_SERVICE_DATABASE_DRIVER=postgres
LICENSE_SERVICE_DATABASE_HOST=postgres
LICENSE_SERVICE_DATABASE_PORT=5432
LICENSE_SERVICE_DATABASE_USER=postgres
LICENSE_SERVICE_DATABASE_PASSWORD=postgres
LICENSE_SERVICE_DATABASE_DBNAME=license_service
LICENSE_SERVICE_DATABASE_SSLMODE=disable
LICENSE_SERVICE_DATABASE_MAX_OPEN_CONNS=25
LICENSE_SERVICE_DATABASE_MAX_IDLE_CONNS=10
LICENSE_SERVICE_DATABASE_CONN_MAX_LIFETIME=5m

LICENSE_SERVICE_REDIS_ADDR=redis:6379
LICENSE_SERVICE_REDIS_USERNAME=
LICENSE_SERVICE_REDIS_PASSWORD=
LICENSE_SERVICE_REDIS_DB=0

# Ed25519 cert signing. Generate a seed with: openssl rand -hex 32
# REQUIRED before `make run` / docker-up. Keep an offline backup — a lost
# seed means all issued certs can never be re-signed.
LICENSE_SIGNING_SEED=
# Rotation transition only — leave empty until rotating keys.
LICENSE_SIGNING_SEED_SECONDARY=
LICENSE_SIGNING_KEY_ID=

# Bearer token for LicenseAdminService RPCs. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Keyless trial duration in days.
TRIAL_DAYS=14

LICENSE_SERVICE_CRON_TIMEZONE=Asia/Shanghai

LICENSE_SERVICE_LOG_LEVEL=info
LICENSE_SERVICE_LOG_FORMAT=json
